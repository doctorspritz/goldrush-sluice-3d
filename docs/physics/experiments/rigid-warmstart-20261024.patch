+//! Opt-in numerical diagnostics, never Session admission or saved continuation.
+use super::*;
+use serde_json::{json, Value};
+
+const PASSIVITY_J: f64 = 0.01;
+const STEPS: usize = 300;
+const HZ: u16 = 480;
+
+fn output(variable: &str) -> std::path::PathBuf {
+    let path =
+        std::path::PathBuf::from(std::env::var_os(variable).expect("fresh diagnostic JSON path"));
+    assert!(!path.exists(), "refuse to overwrite {}", path.display());
+    path
+}
+fn energy(owner: &RetainedSoil, env: &Environment<'_>) -> f64 {
+    super::contact_geometry::independent_energy(owner, env.gravity)
+}
+fn inventory(owner: &RetainedSoil) -> Value {
+    let model = owner.model.as_ref().unwrap();
+    let dynamic: Vec<_> = model
+        .world
+        .bodies
+        .iter()
+        .filter(|(_, body)| body.is_dynamic())
+        .collect();
+    let (machine, _) = model.world.multibody_joints.get(model.joints[0]).unwrap();
+    let motor_rows: u32 = machine
+        .links()
+        .skip(1)
+        .map(|link| link.joint.data.motor_axes.bits().count_ones())
+        .sum();
+    let actuator = owner.machine().articulation.as_ref().unwrap();
+    json!({"clods":owner.soil().clods.len(),"dynamic_bodies":dynamic.len(),
+        "dynamic_mass_kg":dynamic.iter().map(|(_,body)|f64::from(body.mass())).sum::<f64>(),
+        "material":owner.soil().material(),"motor_rows":motor_rows,
+        "pump_work_j":actuator.pump_energy_j,"elastic_energy_j":actuator.feedback.elastic_j,
+        "engine_on":owner.machine().engine_on,"mechanical_hz":owner.machine().tracks.mechanical_hz,
+        "zero_stiffness_and_damping":actuator.stiffness_nm_rad.iter().chain(&actuator.damping_nms_rad).all(|value|*value==0.)})
+}
+fn full_passive_bank(value: &Value) -> bool {
+    value["clods"] == 1040
+        && value["dynamic_bodies"] == 1045
+        && value["motor_rows"] == 0
+        && value["pump_work_j"] == 0.
+        && value["elastic_energy_j"] == 0.
+        && value["engine_on"] == false
+        && value["mechanical_hz"] == HZ
+        && value["zero_stiffness_and_damping"] == true
+}
+fn same_inventory(a: &Value, b: &Value) -> bool {
+    ["clods", "dynamic_bodies", "dynamic_mass_kg", "material"]
+        .into_iter()
+        .all(|key| a[key] == b[key])
+}
+// The experimental flag is deliberately absent from serde. Comparing all
+// serialized parameters never changes the candidate world's flag or state.
+fn physical_parameters(owner: &RetainedSoil) -> Vec<u8> {
+    bincode::serialize(&owner.model.as_ref().unwrap().world.integration_parameters).unwrap()
+}
+fn compact_phases(rows: &rapier3d::contact_work_audit::WorkReport, gravity: Vec3) -> Value {
+    let mut value = serde_json::to_value(rows).unwrap();
+    let contact_blocks = value
+        .as_object_mut()
+        .unwrap()
+        .remove("contacts")
+        .unwrap()
+        .as_array()
+        .unwrap()
+        .len();
+    let phases = value["phases"].as_array().unwrap();
+    let total = |phase: &Value| {
+        phase["kinetic_j"].as_f64().unwrap()
+            - (0..3)
+                .map(|i| f64::from(gravity[i]) * phase["mass_position_kg_m"][i].as_f64().unwrap())
+                .sum::<f64>()
+    };
+    let delta = phases
+        .first()
+        .zip(phases.last())
+        .map(|(first, last)| total(last) - total(first));
+    let island_body_counts: Vec<_> = value["islands"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|island| island.as_array().unwrap().len())
+        .collect();
+    json!({"generic_contact_blocks":contact_blocks,"island_body_counts":island_body_counts,
+        "phase_energy_delta_j":delta,"all_phase_dynamic_bodies_1045":!phases.is_empty() && phases.iter().all(|phase|phase["dynamic_bodies"]==1045),"phases":phases})
+}
+fn observed_step(owner: &mut RetainedSoil, env: &Environment<'_>) -> Value {
+    let initial_energy = energy(owner, env);
+    let before = inventory(owner);
+    let started = std::time::Instant::now();
+    let (result, rows) = rapier3d::contact_work_audit::record(|| {
+        owner.step(MachineInput::default(), 1. / f32::from(HZ), env)
+    });
+    let completed = result.is_ok();
+    let final_energy = completed.then(|| energy(owner, env));
+    let after = completed.then(|| inventory(owner));
+    let phases = compact_phases(&rows, env.gravity);
+    let delta = final_energy.map(|last| last - initial_energy);
+    let agreement = delta
+        .zip(phases["phase_energy_delta_j"].as_f64())
+        .map(|(body, phase)| (body - phase).abs());
+    json!({"completed":completed,"refusal":result.err(),"before":before,"after":after,
+        "initial_body_energy_j":initial_energy,"final_body_energy_j":final_energy,
+        "independent_energy_delta_j":delta,"phase_body_difference_j":agreement,
+        "phase_observer_agrees":agreement.is_some_and(|difference|difference<0.0001),
+        "work_observer":phases,"observer_wall_ms":started.elapsed().as_secs_f64()*1000.,
+        "observer_timing_is_not_a_runtime_benchmark":true,
+        "passivity_gate_j":PASSIVITY_J,"passivity_gate_passed":delta.is_some_and(|gain|gain<=PASSIVITY_J)})
+}
+
+#[test]
+#[ignore = "explicit saved full-bank warm-guess comparison; physical gate is reported separately"]
+fn saved_bank_energy_admissible_warmstart_trial() {
+    let path = output("SLUICE_WARMSTART_TRIAL");
+    let session = bank();
+    let obstacles = session.mechanical_obstacles();
+    let env = Environment {
+        gravity: -Vec3::Y * 9.81,
+        site: Some(&session.site),
+        obstacles: &obstacles,
+        loads: &[],
+    };
+    let bytes = std::fs::read(std::env::var_os("SLUICE_ENERGY_BOUNDARY").unwrap()).unwrap();
+    let reference_bytes =
+        std::fs::read(std::env::var_os("SLUICE_ENERGY_REFERENCE").unwrap()).unwrap();
+    let reference = RetainedSoil::decode(&reference_bytes, &env).unwrap();
+    let mut baseline = RetainedSoil::decode(&bytes, &env).unwrap();
+    let mut candidate = RetainedSoil::decode(&bytes, &env).unwrap();
+    same(
+        &baseline,
+        &candidate,
+        "identical independently decoded starting boundary",
+    );
+    assert_eq!(
+        baseline.encode().unwrap(),
+        bytes,
+        "legacy before boundary changed"
+    );
+    assert_eq!(
+        reference.encode().unwrap(),
+        reference_bytes,
+        "legacy reference encoding changed"
+    );
+    let parameters = physical_parameters(&baseline);
+    assert!(
+        !baseline
+            .model
+            .as_ref()
+            .unwrap()
+            .world
+            .integration_parameters
+            .energy_admissible_rigid_warmstart
+    );
+    candidate
+        .model
+        .as_mut()
+        .unwrap()
+        .world
+        .integration_parameters
+        .energy_admissible_rigid_warmstart = true;
+    assert_eq!(parameters, physical_parameters(&candidate));
+    let persistence_refusal = candidate
+        .encode()
+        .expect_err("candidate must not persist unversioned policy");
+    let initial = inventory(&candidate);
+    assert!(full_passive_bank(&initial));
+    let baseline_report = observed_step(&mut baseline, &env);
+    same(
+        &baseline,
+        &reference,
+        "default policy reference continuation",
+    );
+    assert_eq!(
+        baseline.encode().unwrap(),
+        reference_bytes,
+        "default complete after-state changed"
+    );
+    let candidate_report = observed_step(&mut candidate, &env);
+    let completed = candidate_report["completed"] == true;
+    let candidate_parameters_unchanged = completed && parameters == physical_parameters(&candidate);
+    let candidate_inventory_preserved = completed
+        && same_inventory(&initial, &candidate_report["after"])
+        && full_passive_bank(&candidate_report["after"]);
+    let report = json!({"requested_steps":1,"hz":HZ,"initial":initial,
+        "baseline_before_roundtrip_exact":true,"baseline_after_reference_exact":true,
+        "all_physical_parameters_except_experimental_flag_unchanged":candidate_parameters_unchanged,
+        "candidate_persistence_refused":true,"persistence_refusal":persistence_refusal,
+        "candidate_saved_continuation_claimed":false,"candidate_inventory_preserved":candidate_inventory_preserved,
+        "baseline":baseline_report,"candidate":candidate_report,
+        "passivity_gate_j":PASSIVITY_J,
+        "candidate_passivity_gate_passed":candidate_report["passivity_gate_passed"],
+        "diagnostic_success_is_not_physical_acceptance":true,"full_game_admission":false});
+    std::fs::write(&path, serde_json::to_vec(&report).unwrap()).unwrap();
+    assert!(report["baseline"]["phase_observer_agrees"] == true);
+    assert!(report["baseline"]["work_observer"]["all_phase_dynamic_bodies_1045"] == true);
+    if completed {
+        assert!(candidate_parameters_unchanged && candidate_inventory_preserved);
+        assert!(report["candidate"]["phase_observer_agrees"] == true);
+        assert!(report["candidate"]["work_observer"]["all_phase_dynamic_bodies_1045"] == true);
+    }
+    println!(
+        "WARM GUESS saved trial completed={completed} physical_gate={} path={}",
+        report["candidate_passivity_gate_passed"],
+        path.display()
+    );
+}
