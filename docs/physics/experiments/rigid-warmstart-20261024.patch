+#[test]
+#[ignore = "explicit complete 300-step full-bank passive numerical experiment"]
+fn complete_bank_energy_admissible_warmstart_trajectory() {
+    let path = output("SLUICE_WARMSTART_TRAJECTORY");
+    let mut session = bank();
+    session.machine.engine_on = false;
+    session.machine.tracks.mechanical_hz = HZ;
+    let actuator = session.machine.articulation.as_mut().unwrap();
+    actuator.stiffness_nm_rad.fill(0.);
+    actuator.damping_nms_rad.fill(0.);
+    let obstacles = session.mechanical_obstacles();
+    let env = Environment {
+        gravity: -Vec3::Y * 9.81,
+        site: Some(&session.site),
+        obstacles: &obstacles,
+        loads: &[],
+    };
+    let mut owner = RetainedSoil::new(
+        session.machine.clone(),
+        session.active_soil.take().unwrap(),
+        &env,
+    )
+    .unwrap();
+    assert_eq!(owner.dispatcher, Dispatcher::RigidSoilVerified);
+    let parameters = physical_parameters(&owner);
+    assert!(
+        owner
+            .model
+            .as_ref()
+            .unwrap()
+            .world
+            .integration_parameters
+            .friction_in_bias_pass
+    );
+    owner
+        .model
+        .as_mut()
+        .unwrap()
+        .world
+        .integration_parameters
+        .energy_admissible_rigid_warmstart = true;
+    let persistence_refusal = owner
+        .encode()
+        .expect_err("candidate policy must refuse persistence");
+    let initial = inventory(&owner);
+    assert!(full_passive_bank(&initial));
+    let initial_energy = energy(&owner, &env);
+    let mut last_energy = initial_energy;
+    let mut trajectory = Vec::new();
+    let mut refusal = None;
+    let mut observations_valid = true;
+    let started = std::time::Instant::now();
+    for step in 0..STEPS {
+        if let Err(error) = owner.step(MachineInput::default(), 1. / f32::from(HZ), &env) {
+            refusal = Some(
+                json!({"attempted_step":step+1,"error":error,"owner_poisoned":owner.failed()}),
+            );
+            break;
+        }
+        let current = energy(&owner, &env);
+        let delta = current - last_energy;
+        let inventory = inventory(&owner);
+        let preserved = same_inventory(&initial, &inventory) && full_passive_bank(&inventory);
+        let parameter_match = parameters == physical_parameters(&owner)
+            && owner
+                .model
+                .as_ref()
+                .unwrap()
+                .world
+                .integration_parameters
+                .energy_admissible_rigid_warmstart;
+        let feedback = owner.soil().feedback.coupled_passivity_residual_j;
+        let observer_match = (delta - feedback).abs() < 0.05;
+        observations_valid &= current.is_finite() && preserved && parameter_match && observer_match;
+        trajectory.push(json!({"step":step+1,"total_energy_j":current,"delta_energy_j":delta,
+            "reported_residual_j":feedback,"independent_feedback_agrees":observer_match,
+            "inventory":inventory,"inventory_preserved":preserved,"physical_parameters_unchanged":parameter_match,
+            "passivity_gate_passed":delta<=PASSIVITY_J}));
+        last_energy = current;
+    }
+    let completed = trajectory.len() == STEPS && refusal.is_none();
+    let violations = trajectory
+        .iter()
+        .filter(|row| row["passivity_gate_passed"] != true)
+        .count();
+    let maximum = trajectory
+        .iter()
+        .filter_map(|row| row["delta_energy_j"].as_f64())
+        .reduce(f64::max);
+    let report = json!({"requested_steps":STEPS,"completed_steps":trajectory.len(),"hz":HZ,
+        "trajectory_completed":completed,"refusal":refusal,"initial":initial,
+        "initial_energy_j":initial_energy,"last_accepted_energy_j":last_energy,
+        "net_energy_change_accepted_j":last_energy-initial_energy,"maximum_step_energy_gain_j":maximum,
+        "passivity_gate_j":PASSIVITY_J,"violations":violations,
+        "all_steps_passivity_gate_passed":completed && violations==0,
+        "observations_valid":observations_valid,"candidate_persistence_refused":true,
+        "persistence_refusal":persistence_refusal,"candidate_saved_continuation_claimed":false,
+        "physical_contact_count_or_cadence_reduction":false,"diagnostic_success_is_not_physical_acceptance":true,
+        "wall_seconds":started.elapsed().as_secs_f64(),"trajectory":trajectory,"full_game_admission":false});
+    std::fs::write(&path, serde_json::to_vec(&report).unwrap()).unwrap();
+    assert!(
+        observations_valid,
+        "independent energy/custody/parameter observations invalid; inspect report"
+    );
+    assert!(
+        completed || report["refusal"].is_object(),
+        "incomplete trajectory needs actual refusal"
+    );
+    println!(
+        "WARM GUESS trajectory accepted={}/{} violations={violations} physical_gate={} path={}",
+        report["completed_steps"],
+        STEPS,
+        report["all_steps_passivity_gate_passed"],
+        path.display()
+    );
+}
