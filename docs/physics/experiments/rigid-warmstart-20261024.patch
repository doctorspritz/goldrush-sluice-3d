+mod tests {
+    use super::*;
+
+    #[test]
+    fn experimental_warm_start_cannot_silently_lose_its_policy_on_save() {
+        let mut history =
+            ContactHistory::from_world(r::PhysicsWorld::default(), Dispatcher::Default);
+        let legacy = history.encode().unwrap();
+        let restored = ContactHistory::decode(&legacy).unwrap();
+        assert!(
+            !restored
+                .world()
+                .integration_parameters
+                .energy_admissible_rigid_warmstart
+        );
+        assert_eq!(restored.encode().unwrap(), legacy);
+        history
+            .world_mut()
+            .integration_parameters
+            .energy_admissible_rigid_warmstart = true;
+        assert!(history
+            .encode()
+            .unwrap_err()
+            .contains("versioned persistence"));
+        assert!(
