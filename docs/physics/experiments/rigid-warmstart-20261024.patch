+                .clone()
+                .world()
+                .integration_parameters
+                .energy_admissible_rigid_warmstart
+        );
+        assert!(history.clone().encode().is_err());
+        history
+            .world_mut()
+            .integration_parameters
+            .energy_admissible_rigid_warmstart = false;
+        assert_eq!(history.encode().unwrap(), legacy);
